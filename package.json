{
  "name": "oyama-ai-video-studio",
  "version": "1.0.0-alpha.50",
  "private": true,
  "description": "Local-first AI video studio powered by ComfyUI",
  "author": {
    "name": "James Knox",
    "email": "contact@jamesnox.com"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:web\" \"pnpm dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "pnpm build:electron && wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/launch-electron.cjs",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:electron",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm test:navigation && pnpm test:scene && pnpm test:workflows && pnpm test:continuation && pnpm test:atomic-saves && pnpm test:movie-editor && pnpm test:comfy-cancel && pnpm test:comfy-job-state && pnpm test:job-persistence && pnpm test:workspace-persistence",
    "test:comfy-cancel": "node scripts/test-comfy-cancel.cjs",
    "test:comfy-job-state": "node scripts/test-comfy-job-state.cjs",
    "test:job-persistence": "node scripts/test-job-persistence.cjs",
    "test:ui-e2e": "node scripts/test-ui-e2e.cjs",
    "test:workspace-persistence": "node scripts/test-workspace-persistence.cjs",
    "test:navigation": "node scripts/test-workspace-navigation.cjs",
    "test:continuation": "node scripts/test-continuation.cjs",
    "test:scene": "node scripts/test-scene-compiler.cjs",
    "test:clip-master": "node scripts/test-clip-master.cjs",
    "test:movie-editor": "node scripts/test-movie-editor.cjs",
    "test:atomic-saves": "node scripts/test-atomic-saves.cjs",
    "package:all": "node scripts/release-all.cjs",
    "test:workflows": "node scripts/test-workflows.cjs",
    "smoke:lan": "node scripts/smoke-lan.cjs",
    "start": "node scripts/launch-electron.cjs",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --config.npmRebuild=false",
    "package:linux": "pnpm build && electron-builder --linux zip --x64 --config.npmRebuild=false",
    "package:linux:deb": "pnpm build && electron-builder --linux deb --x64 --config.npmRebuild=false",
    "package:linux:appimage": "pnpm build && electron-builder --linux AppImage --x64 --config.npmRebuild=false",
    "package:linux:tar": "pnpm build && electron-builder --linux tar.gz --x64 --config.npmRebuild=false",
    "package:mac": "pnpm build && electron-builder --mac zip --x64 --arm64 --config.npmRebuild=false"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.2",
    "@eslint/js": "^9.17.0",
    "@rollup/rollup-win32-x64-msvc": "4.63.1",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "pnpm": {
    "overrides": {
      "@electron/rebuild": "3.7.2",
      "electron-builder-squirrel-windows": "26.0.12"
    }
  },
  "build": {
    "appId": "com.james.oyamaaivideostudio",
    "productName": "Oyama AI Video Studio",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Oyama-AI-Video-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oyama AI Video Studio",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "maintainer": "James Knox <contact@jamesnox.com>",
      "synopsis": "Local-first AI filmmaking workstation",
      "description": "Oyama AI Video Studio is a local-first AI filmmaking workstation powered by ComfyUI.",
      "artifactName": "Oyama-AI-Video-Studio-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "artifactName": "Oyama-AI-Video-Studio-${version}-mac-${arch}.${ext}"
    }
  }
}
